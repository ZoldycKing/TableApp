DATABASE_URL=postgres://tableapp:tableapp@localhost:5433/tableapp
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=tableapp
S3_SECRET_KEY=tableapp123
S3_BUCKET=tableapp
AUTH_SECRET=dev-secret-change-me
APP_URL=http://localhost:3000

# Публичный адрес сайта: по нему строятся канонические ссылки, карта сайта
# и robots.txt. В рабочем виде обязателен — канонический адрес с localhost
# поисковику не объяснить. В разработке можно не задавать: подставится APP_URL.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_METRIKA_ID= # номер счётчика Яндекс.Метрики; пусто — счётчик выключен

# Почта. Без этих двух переменных код входа печатается в консоль сервера.
#
# Для разработки проще всего приёмник из docker-compose: письма никуда
# не уходят, их видно на http://localhost:8025 — вёрстку и текст проверять
# на нём, не трогая настоящий ящик.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=robot@tableapp.local
MAIL_FROM_NAME=TableApp

# Чтобы отправлять по-настоящему, замените две строки выше.
#
# Яндекс (личный ящик): включите IMAP в настройках почты и создайте пароль
# приложения на id.yandex.ru → Безопасность → Пароли приложений. «@» в логине
# внутри адреса пишется как %40, иначе разбор адреса обрывается на нём.
# Отправитель обязан совпадать с ящиком, под которым идёт авторизация.
#
# SMTP_URL=smtps://login%40yandex.ru:parol-prilozheniya@smtp.yandex.ru:465
# MAIL_FROM=login@yandex.ru

# Приём оплаты подписки. Без PAYMENTS_MODE кнопки оплаты честно отвечают,
# что приём не подключён, и предлагают счёт по почте.
#
# PAYMENTS_MODE=test       проверочный контур: деньги не списываются,
#                          платёж подтверждается вручную на /pay/<id>
# PAYMENTS_MODE=yookassa   настоящий приём оплаты, нужны ключи магазина
#
# PAYMENTS_MODE=
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
#
# Адрес для уведомлений в кабинете провайдера: /api/payments/yookassa
# Подробности подключения — docs/payments.md
